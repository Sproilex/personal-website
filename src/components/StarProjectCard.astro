---
// No props — driven entirely by project-hover / project-hover-end CustomEvents
// dispatched from stars.ts when the cursor enters or leaves a project star.
---

<a
    id="star-project-card"
    href="#"
    tabindex="-1"
    aria-hidden="true"
    class="fixed z-[9999] w-64 rounded-lg border border-border bg-surface flex flex-col overflow-hidden opacity-0 pointer-events-none transition-opacity duration-150">
    <!-- Accent strip using the site's highlight color -->
    <div class="h-0.5 w-full shrink-0 bg-text-highlight"></div>

    <!-- Thumbnail (hidden when no thumbnail URL is provided) -->
    <div
        id="star-project-card-thumb"
        class="w-full aspect-video bg-surface-2 overflow-hidden shrink-0 hidden">
        <img
            id="star-project-card-img"
            src=""
            alt=""
            class="w-full h-full object-cover object-top"
        />
    </div>

    <!-- Body -->
    <div class="flex flex-col gap-2 p-4">
        <h3
            id="star-project-card-title"
            class="font-display text-sm font-semibold text-text leading-tight">
        </h3>
        <p
            id="star-project-card-desc"
            class="text-xs text-text-muted leading-relaxed line-clamp-2">
        </p>
        <span
            class="flex items-center gap-1 text-xs font-display tracking-widest uppercase text-text-highlight transition-all mt-1 pt-2 border-t border-border">
            View project →
        </span>
    </div>
</a>

<script>
    let hideTimer: ReturnType<typeof setTimeout> | null = null;

    function card(): HTMLAnchorElement | null {
        return document.getElementById("star-project-card") as HTMLAnchorElement | null;
    }

    function show(): void {
        const el = card();
        if (!el) return;
        el.classList.remove("opacity-0", "pointer-events-none");
        el.removeAttribute("aria-hidden");
        el.removeAttribute("tabindex");
    }

    function hide(): void {
        const el = card();
        if (!el) return;
        el.classList.add("opacity-0", "pointer-events-none");
        el.setAttribute("aria-hidden", "true");
        el.setAttribute("tabindex", "-1");
    }

    function scheduleHide(): void {
        clearHideTimer();
        hideTimer = setTimeout(hide, 150);
    }

    function clearHideTimer(): void {
        if (hideTimer !== null) {
            clearTimeout(hideTimer);
            hideTimer = null;
        }
    }

    // Bind the card's own hover listeners once the element is guaranteed to be in the DOM.
    // transition:persist keeps the same node alive, so one-time binding is enough.
    document.addEventListener("astro:page-load", () => {
        const el = card();
        if (!el) return;
        el.addEventListener("mouseenter", clearHideTimer);
        el.addEventListener("mouseleave", scheduleHide);
    }, { once: true });

    window.addEventListener("project-hover", (e: Event) => {
        const el = card();
        if (!el) return;

        const { project, cssX, cssY } = (
            e as CustomEvent<{
                project: {
                    id: string;
                    title: string;
                    description: string;
                    href: string;
                    thumbnail?: string;
                };
                cssX: number;
                cssY: number;
            }>
        ).detail;

        clearHideTimer();

        el.href = project.href;

        const titleEl = document.getElementById("star-project-card-title");
        const descEl = document.getElementById("star-project-card-desc");
        const thumbWrapper = document.getElementById("star-project-card-thumb");
        const thumbImg = document.getElementById("star-project-card-img") as HTMLImageElement | null;

        if (titleEl) titleEl.textContent = project.title;
        if (descEl) descEl.textContent = project.description;

        if (project.thumbnail && thumbWrapper && thumbImg) {
            thumbImg.src = project.thumbnail;
            thumbImg.alt = project.title;
            thumbWrapper.classList.remove("hidden");
        } else if (thumbWrapper) {
            thumbWrapper.classList.add("hidden");
        }

        // Measure height while opacity-0 so offsetHeight is accurate.
        const CARD_W = 256; // w-64
        const GAP = 20;
        const cardH = el.offsetHeight;
        const margin = 8;

        let left = cssX - CARD_W / 2;
        let top = cssY - cardH - GAP;

        left = Math.max(margin, Math.min(left, window.innerWidth - CARD_W - margin));
        if (top < margin) top = cssY + GAP;

        el.style.left = `${left}px`;
        el.style.top = `${top}px`;

        show();
    });

    window.addEventListener("project-hover-end", () => {
        scheduleHide();
    });
</script>
