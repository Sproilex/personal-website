---
import { Icon } from "astro-icon/components";
import BaseModal from "./BaseModal.astro";

interface Props {
    id: string;
    title: string;
    src: string;
    downloadHref: string;
    shareTitle: string;
    triggerAttribute?: string;
}

const { id, title, src, downloadHref, shareTitle, triggerAttribute } = Astro.props;
---

<BaseModal {id} {title} {triggerAttribute} dialogClass="max-w-4xl">
    <div class="flex-1 overflow-hidden min-h-0 bg-bg h-full">
        <iframe
            class="pdf-modal-iframe w-full h-full min-h-[60dvh]"
            title={title}
            data-pdf-src={src}
        ></iframe>
    </div>

    <div slot="footer" class="flex gap-3 w-full sm:w-auto">
        <a
            href={downloadHref}
            download
            class="btn flex-1 sm:flex-none flex items-center justify-center gap-2">
            <Icon name="mdi:download" class="w-4 h-4 shrink-0" />
            Download
        </a>
        <button
            class="pdf-modal-share btn btn-primary flex-1 sm:flex-none flex items-center justify-center gap-2"
            data-pdf-share-title={shareTitle}
            data-pdf-share-url={src}>
            <Icon name="mdi:share-variant" class="w-4 h-4 shrink-0" />
            <span class="pdf-modal-share-label">Share</span>
        </button>
    </div>
</BaseModal>

<script>
    function initPdfExtras(dialog: HTMLDialogElement) {
        const iframe    = dialog.querySelector<HTMLIFrameElement>(".pdf-modal-iframe");
        const shareBtn  = dialog.querySelector<HTMLButtonElement>(".pdf-modal-share");
        const shareLabel = dialog.querySelector<HTMLElement>(".pdf-modal-share-label");

        if (iframe) {
            const src = iframe.dataset.pdfSrc ?? "";
            const observer = new MutationObserver(() => {
                if (dialog.open && iframe.src !== src) iframe.src = src;
            });
            observer.observe(dialog, { attributes: true, attributeFilter: ["open"] });
        }

        shareBtn?.addEventListener("click", async () => {
            const url   = new URL(shareBtn.dataset.pdfShareUrl ?? "", window.location.origin).href;
            const title = shareBtn.dataset.pdfShareTitle ?? "";

            if (navigator.share) {
                try { await navigator.share({ title, url }); } catch {}
                return;
            }
            try {
                await navigator.clipboard.writeText(url);
                if (shareLabel) shareLabel.textContent = "Copied!";
                setTimeout(() => { if (shareLabel) shareLabel.textContent = "Share"; }, 2000);
            } catch {}
        });
    }

    function initAllPdfExtras() {
        document.querySelectorAll<HTMLDialogElement>("dialog.base-modal").forEach((dialog) => {
            if (dialog.querySelector(".pdf-modal-iframe")) initPdfExtras(dialog);
        });
    }

    initAllPdfExtras();
    document.addEventListener("astro:page-load", initAllPdfExtras);
</script>
