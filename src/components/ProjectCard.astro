---
interface Props {
    title: string;
    year?: string;
    description: string;
    category?: string;
    technologies: string[];
    image?: string;
    caseStudyUrl?: string;
}

const {
    title,
    year,
    description,
    category,
    technologies,
    image,
    caseStudyUrl = "#",
} = Astro.props;
---

<article
    class="min-w-[300px] w-100% rounded-lg border border-border overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-2"
    data-category={category?.toLowerCase()}>
    <a
        href={caseStudyUrl}
        aria-label={`${title} — case study`}
        class="relative h-fit shrink-0 bg-bg-secondary overflow-hidden">
        {
            image && (
                <img
                    src={`/images/${image}`}
                    alt=""
                    class="w-full w-full object-cover object-top"
                />
            )
        }
        <div class="absolute inset-0 p-5 flex flex-col justify-between">
            {
                category && (
                    <span class="self-start text-xs font-display tracking-widest uppercase border border-border bg-bg/80 text-text-muted px-2 py-1 rounded">
                        {category}
                    </span>
                )
            }
        </div>
    </a>

    <div class="flex flex-col gap-4 p-6 bg-bg flex-1">
        <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-2xl font-medium text-text">{title}</h3>
        </div>

        <p class="text-text-muted text-base leading-relaxed">{description}</p>

        <div class="flex flex-wrap gap-1">
            {
                technologies
                    .slice(0, 4)
                    .map((tech) => (
                        <span class="px-2 py-1 rounded-md border border-border text-xs text-text-muted bg-bg">
                            {tech}
                        </span>
                    ))
            }
            {
                technologies.length > 4 && (
                    <span class="px-2 py-1 rounded-md border border-border text-sm text-text-muted bg-bg">
                        +{technologies.length - 4}
                    </span>
                )
            }
        </div>

        <a
            href={caseStudyUrl}
            aria-label={`${title} — case study`}
            tabindex="-1"
            aria-hidden="true"
            class="flex items-center gap-2 text-sm font-display tracking-widest uppercase text-text-highlight hover:scale-105 transition-all mt-auto pt-2">
            Case Study →
        </a>
    </div>
</article>
