---
interface Props {
    title: string;
    year?: string;
    description: string;
    category?: string;
    technologies: string[];
    image?: string;
    caseStudyUrl?: string;
}

const {
    title,
    year,
    description,
    category,
    technologies,
    image,
    caseStudyUrl = "#",
} = Astro.props;
---

<article class="rounded-lg border border-border overflow-hidden flex flex-col">
    <div class="relative h-64 shrink-0 bg-bg-secondary overflow-hidden">
        {
            image && (
                <img
                    src={`/images/${image}`}
                    alt={title}
                    class="w-full w-full object-cover object-top"
                />
            )
        }
        <div class="absolute inset-0 p-5 flex flex-col justify-between">
            {
                category && (
                    <span class="self-start text-xs font-display tracking-widest uppercase border border-border bg-bg/80 text-text-muted px-2 py-1 rounded">
                        {category}
                    </span>
                )
            }
        </div>
    </div>

    <div class="flex flex-col gap-4 p-6 bg-bg flex-1">
        <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-2xl font-medium text-text">{title}</h3>
            {
                year && (
                    <span class="text-text-muted text-sm shrink-0">{year}</span>
                )
            }
        </div>

        <p class="text-text-muted text-base leading-relaxed">{description}</p>

        <div class="flex flex-wrap gap-2">
            {
                technologies
                    .slice(0, 4)
                    .map((tech) => (
                        <span class="px-3 py-1.5 rounded-md border border-border text-sm text-text-muted bg-bg">
                            {tech}
                        </span>
                    ))
            }
            {
                technologies.length > 4 && (
                    <span class="px-3 py-1.5 rounded-md border border-border text-sm text-text-muted bg-bg">
                        +{technologies.length - 4}
                    </span>
                )
            }
        </div>

        <a
            href={caseStudyUrl}
            class="flex items-center gap-2 text-sm font-display tracking-widest uppercase text-text-highlight hover:scale-105 transition-all mt-auto pt-2">
            Case Study →
        </a>
    </div>
</article>
