---
import { Icon } from "astro-icon/components";
---

<style is:global>
    @keyframes resume-slide-in {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    @keyframes resume-slide-out {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(-100%);
            opacity: 0;
        }
    }
    @keyframes resume-backdrop-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes resume-backdrop-out {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }

    #resume-modal {
        top: 0;
        bottom: 0;
    }
    #resume-modal[open] {
        animation: resume-slide-in 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)
            both;
    }
    #resume-modal.is-closing {
        animation: resume-slide-out 0.28s cubic-bezier(0.55, 0, 1, 0.45) both;
    }
    #resume-modal[open]::backdrop {
        animation: resume-backdrop-in 0.35s ease both;
    }
    #resume-modal.is-closing::backdrop {
        animation: resume-backdrop-out 0.28s ease both;
    }
</style>

<dialog
    id="resume-modal"
    aria-labelledby="resume-modal-title"
    class="m-auto w-[calc(100%-2rem)] sm:w-full max-w-4xl max-h-[90dvh] rounded-xl border-2 border-border bg-surface p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:flex-col">
    <!-- Header -->
    <div
        class="flex items-center justify-between border-b-2 border-border px-6 py-4 shrink-0">
        <span
            id="resume-modal-title"
            class="font-display text-sm tracking-widest uppercase text-text-highlight">
            Resume
        </span>
        <button
            id="resume-modal-close"
            aria-label="Close"
            class="flex items-center justify-center w-8 h-8 rounded-md text-text-muted hover:text-text hover:border-border border-2 border-transparent transition-colors">
            <Icon
                name="mdi:close"
                class="w-5 h-5"
            />
        </button>
    </div>

    <!-- PDF Preview -->
    <div class="flex-1 overflow-hidden min-h-0 bg-bg">
        <iframe
            id="resume-iframe"
            data-src="/Resume_StivenIlarraza.pdf"
            title="Résumé preview"
            class="w-full h-full min-h-[60dvh]"
        ></iframe>
    </div>

    <!-- Footer -->
    <div
        class="flex items-center justify-end gap-4 border-t-2 border-border px-6 py-4 shrink-0">
        <div class="flex gap-3 w-full sm:w-auto">
            <a
                href="/resume.pdf"
                download
                class="btn flex-1 sm:flex-none flex items-center justify-center gap-2">
                <Icon
                    name="mdi:download"
                    class="w-4 h-4 shrink-0"
                />
                Download
            </a>
            <button
                id="resume-share-btn"
                class="btn btn-primary flex-1 sm:flex-none flex items-center justify-center gap-2">
                <Icon
                    name="mdi:share-variant"
                    class="w-4 h-4 shrink-0"
                />
                <span id="resume-share-label">Share</span>
            </button>
        </div>
    </div>
</dialog>

<script>
    function initResumeModal() {
        const modal = document.getElementById(
            "resume-modal",
        ) as HTMLDialogElement | null;
        const closeBtn = document.getElementById("resume-modal-close");
        const shareBtn = document.getElementById("resume-share-btn");
        const shareLabel = document.getElementById("resume-share-label");
        const iframe = document.getElementById(
            "resume-iframe",
        ) as HTMLIFrameElement | null;

        if (!modal) return;

        function openModal() {
            if (
                iframe &&
                iframe.dataset.src &&
                !iframe.src.endsWith(iframe.dataset.src)
            ) {
                iframe.src = iframe.dataset.src;
            }
            modal!.showModal();
        }

        function closeModal() {
            modal!.classList.add("is-closing");
            modal!.addEventListener(
                "animationend",
                () => {
                    modal!.classList.remove("is-closing");
                    modal!.close();
                },
                { once: true },
            );
        }

        // Trigger buttons (any element with data-resume-trigger)
        document.querySelectorAll("[data-resume-trigger]").forEach((el) => {
            el.addEventListener("click", openModal);
        });

        closeBtn?.addEventListener("click", closeModal);

        // Click outside the panel closes the modal
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeModal();
        });

        // Intercept ESC so the exit animation plays before close
        modal.addEventListener("cancel", (e) => {
            e.preventDefault();
            closeModal();
        });

        // Share / clipboard fallback
        shareBtn?.addEventListener("click", async () => {
            const url = new URL("/resume.pdf", window.location.origin).href;

            if (navigator.share) {
                try {
                    await navigator.share({
                        title: "Stiven Ilarraza — Résumé",
                        url,
                    });
                } catch {
                    // User cancelled — no-op
                }
                return;
            }

            // Clipboard fallback
            try {
                await navigator.clipboard.writeText(url);
                if (shareLabel) shareLabel.textContent = "Copied!";
                setTimeout(() => {
                    if (shareLabel) shareLabel.textContent = "Share";
                }, 2000);
            } catch {
                // Clipboard also unavailable — silent fail
            }
        });
    }

    initResumeModal();
    document.addEventListener("astro:page-load", initResumeModal);
</script>
