---
import { Icon } from 'astro-icon/components';
const {title} = Astro.props;
---
<div class="bg-surface border-border border-b-2 box-content">
    <span class="bg-surface-2 flex items-center gap-2 px-3   py-1 rounded-t-lg border-border border-b-surface-2 border-2 w-fit -mb-[2px] text-sm">
        <Icon name="mdi:information-outline" />
        {title}
    </span>
</div>