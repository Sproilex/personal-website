---
import Panel from './panel.astro';
import { Icon } from 'astro-icon/components';
import TreeView from './tree-view/tree-view';
import type { TreeItem } from './tree-view/tree-view';
import Tabs from '../tabs.astro';

const treeData: TreeItem[] = [
    {
        title: 'Project 1',
        description: 'First project',
        type: 'project',
        children: [
            { title: 'File 1.1', description: 'First file in project 1', type: 'file' },
            { title: 'File 1.2', description: 'Second file in project 1', type: 'file' },
        ],
    },
    {
        title: 'Project 2',
        type: 'project',
        description: 'Second project',
        children: [
            { title: 'File 2.1', description: 'First file in project 2', type: 'file' },
            { title: 'File 2.2', description: 'Second file in project 2', type: 'file' },
        ],
    },
];

---
<Panel tabTitle="Explorer">
    <div class="w-full flex p-2 rounded-lg border-border border-2 gap-2 items-center px-4 py-2 mb-4">
        <Icon class="w-4 h-4" name="mdi:search" />
        <input class="focus:outline-none" type="text" placeholder="Search projects..." class="" />
    </div>

    <Tabs tabs={['Projects', 'Stacks']}>
        <Fragment slot="Projects">
            <h4 class="text-lg font-bold mb-1 mt-4">Projects</h4>
            <TreeView treeData={treeData} client:load/>
        </Fragment>
    </Tabs>
</Panel>