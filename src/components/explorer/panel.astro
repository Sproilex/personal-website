---
import PanelTitle from './panel-title.astro';

const {tabTitle} = Astro.props;
---

<div class="bg-surface-2 w-4xl flex flex-col rounded-b-lg min-h-0">

    <PanelTitle title={tabTitle} />

    <div class="border-border border-2 h-full border-t-0 rounded-b-lg p-4 max-h-[calc(100vh-4rem)] overflow-y-auto">
        <slot/>
    </div>

</div>