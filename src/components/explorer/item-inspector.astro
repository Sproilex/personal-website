---
import { Icon } from 'astro-icon/components';
import { getCollection, getEntry } from 'astro:content';

import TechnologyBadge from '../technology-badge.astro';
import Panel from './panel.astro';

const projects = await getCollection('projects');
---
<Panel tabTitle="Inspector">
    <div class="flex items-center p-2 border-border border-2 rounded-lg mb-4">
        <div class="bg-surface-2 rounded-lg flex items-center justify-center">
            <Icon class="w-12 h-12" name="mdi:folder" />
        </div>

        <div class="ml-4">
            <h3 class="text-lg font-bold">{projects[0].data.title}</h3>
            <div class="flex gap-2">
                <span>{projects[0].data.company}</span>
                |
                <span>{projects[0].data.type}</span>
            </div>
        </div>
    </div>

    <ul class="flex items-stretch text-sm font-bold mb-4">
        <li class="flex p-1 border-border-strong border-b-2 px-4 w-full justify-center">Overview</li>
        <li class="flex p-1 border-border border-b-2 px-4 w-full justify-center">Tech Stack</li>
        <li class="flex p-1 border-border border-b-2 px-4 w-full justify-center">Details</li>
    </ul>

    <div aria-label="overview">
        <h4 class="text-lg font-bold mb-1">Summary</h4>
        <p class="text-sm">{projects[0].data.description}</p>

        <h4 class="text-lg font-bold mb-1 mt-4">My Role</h4>
        <p class="text-sm">{projects[0].data.role}</p>

        <h4 class="text-lg font-bold mb-1 mt-4">Technologies</h4>
        <div class="flex gap-1 flex-wrap">
            {projects[0].data.technologies?.splice(0, 6).map((tag) => (
                <TechnologyBadge name={tag} />
            ))}
        </div>
        {projects[0].data.technologies?.length > 6 && (
            <span class="text-sm font-bold text-primary-strong">+{projects[0].data.technologies.length - 6} more</span>
        )}

        <h4 class="text-lg font-bold mb-1 mt-4">Highlights</h4>
        <div class="flex">
            <div class="flex gap-4 p-2 border-border border-r-2">
                <Icon class="w-8 h-8" name="mdi:chart-line" />
                <span>
                    <span class="text-lg font-bold">40%</span>
                    <p class="text-xs">Increase in productivity</p>
                </span>
            </div>
            <div class="flex gap-4 p-2 border-border border-r-2">
                <Icon class="w-8 h-8" name="mdi:office-building" />
                <span>
                    <span class="text-lg font-bold">+10</span>
                    <p class="text-xs">Active Companies</p>
                </span>
            </div>
            <div class="flex gap-4 p-2">
                <Icon class="w-8 h-8" name="mdi:office-building" />
                <span>
                    <span class="text-lg font-bold">+10</span>
                    <p class="text-xs">Active Companies</p>
                </span>
            </div>
        </div>

        <button class="flex bg-accent hover:bg-accent-hover hover:cursor-pointer hover:scale-105 items-center gap-6 px-4 py-3 rounded-lg font-bold mt-4 mx-auto">
            See All Details
            <Icon class="w-5 h-5" name="mdi:open-in-new" />
        </button>
        
    </div>
</Panel>