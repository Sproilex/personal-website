---
import "../styles/global.css";
import "@fontsource/space-grotesk/600.css";
import Navbar from "../components/Navbar.astro";
import ResumeModal from "../components/ResumeModal.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "Stiven Ilarraza — Software Engineer",
    description = "Software engineer with over 8 years of experience building products, systems, and digital experiences across the stack.",
    ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgImage = ogImage
    ? new URL(ogImage, Astro.site).href
    : undefined;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Stiven Ilarraza" />
        {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

        <title>{title}</title>
        <ClientRouter />
    </head>

    <body
        class="m-0 h-dvh overflow-hidden bg-bg text-text scrollbar-thin scrollbar-thumb-text-highlight scrollbar-track-surface">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-surface focus:border-2 focus:border-accent focus:text-text focus:outline-none">
            Skip to content
        </a>

        <main class="relative h-dvh w-full overflow-hidden">
            <!-- STAR FIELD -->
            <!-- 200vw×200vh oversized canvas — viewport sees the center half.
                 The ±50vw/vh buffer gives room to translate during page transitions
                 without exposing canvas edges. Clipped by <main overflow-hidden>. -->
            <div
                id="stars"
                class="pointer-events-none absolute z-0"
                style="left: -50vw; top: -50vh; width: 200vw; height: 200vh;"
                aria-hidden="true"
                transition:persist>
            </div>

            <!-- BACKGROUND ATMOSPHERE -->
            <div
                class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(circle_at_70%_50%,color-mix(in_srgb,var(--color-accent)_7%,transparent),transparent_35%)]"
                aria-hidden="true">
            </div>

            <Navbar />

            <div
                id="main-content"
                class="absolute flex w-full h-full z-10 top-0 left-0 lg:pl-[120px]">
                <slot />
            </div>
        </main>

        <ResumeModal />

        <script>
            import "../scripts/stars";
            import "../scripts/space-pan";
        </script>
    </body>
</html>
