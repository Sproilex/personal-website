---
import "../styles/global.css";
import "@fontsource/space-grotesk/600.css";
import Navbar from "../components/Navbar.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "Stiven Ilarraza — Software Engineer",
    description = "Software engineer with over 8 years of experience building products, systems, and digital experiences across the stack.",
    ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgImage = ogImage
    ? new URL(ogImage, Astro.site).href
    : undefined;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Stiven Ilarraza" />
        {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

        <title>{title}</title>
        <ClientRouter />
    </head>

    <body
        class="m-0 h-dvh overflow-hidden bg-bg text-text scrollbar-thin scrollbar-thumb-text-highlight scrollbar-track-surface">
        <main class="relative h-dvh w-full overflow-hidden">
            <!-- STAR FIELD -->
            <div
                id="stars"
                class="pointer-events-none absolute inset-0 z-0 h-full w-full"
                aria-hidden="true"
                transition:persist>
            </div>

            <!-- BACKGROUND ATMOSPHERE -->
            <div
                class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(circle_at_70%_50%,color-mix(in_srgb,var(--color-accent)_7%,transparent),transparent_35%)]"
                aria-hidden="true">
            </div>

            <Navbar />

            <div
                class="absolute flex w-full h-full z-10 top-0 left-0 lg:pl-[120px]">
                <slot />
            </div>
        </main>

        <script>
            import "../scripts/stars";
        </script>
    </body>
</html>
