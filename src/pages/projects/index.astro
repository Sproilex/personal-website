---
import Page from "../../layouts/page.astro";
import PillSelect from "../../components/PillSelect.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { projectsTransition } from "../../transitions";

const projects = await getCollection("projects");

const uniqueCategories = [...new Set(projects.map((p) => p.data.category).filter(Boolean))] as string[];
const filterOptions = [
    { label: "All", value: "all" },
    ...uniqueCategories.map((c) => ({ label: c, value: c.toLowerCase() })),
];
---

<style>
    @reference "#global.css";

    .abilities li {
        @apply flex gap-4;
    }

    .abilities h2 {
        @apply text-2xl mb-2 leading-[1];
    }

    .abilities p {
        @apply text-base text-text-muted;
    }

    .abilities span {
        @apply text-sm text-text-highlight;
    }

    .projects-grid {
        @apply grid auto-rows-max gap-4 flex-1 pb-8 -mt-4 pt-6 overflow-y-auto pr-4 grid-cols-[repeat(auto-fill,minmax(280px,1fr))];
    }
</style>

<Page
    title="Projects — Stiven Ilarraza"
    description="Selected work spanning product engineering, front-end systems, APIs, and cloud delivery. Eight years of shipped software."
>
    <section
        class="flex flex-col h-full w-full px-4 sm:px-6 lg:pl-[4vw] lg:pr-[4vw] gap-6 lg:gap-8 pt-16 md:pt-[4vw]"
        aria-labelledby="hero-title"
        transition:name="page-content"
        transition:animate={projectsTransition}>
        <h1
            id="hero-title"
            class="font-display text-6xl sm:text-7xl lg:text-8xl font-medium uppercase leading-[0.82] tracking-[-0.04em] shrink-0">
            <span class="block text-text"> Selected </span>
            <span class="block text-text-highlight"> Work </span>
        </h1>

        <PillSelect
            name="filter"
            defaultValue="all"
            aria-label="Filter projects by category"
            options={filterOptions}
        />

        <div class="projects-grid">
            {
                projects.map((p) => (
                    <ProjectCard
                        title={p.data.title}
                        year={p.data.year}
                        description={p.data.description}
                        category={p.data.category}
                        technologies={p.data.technologies}
                        image={p.data.image}
                        caseStudyUrl={
                            p.data.slug ? `/projects/${p.data.slug}` : "#"
                        }
                    />
                ))
            }
        </div>
    </section>
</Page>

<script>
    function initFilter() {
        const radios = document.querySelectorAll<HTMLInputElement>('input[name="filter"]');
        const cards = document.querySelectorAll<HTMLElement>('article[data-category]');

        function applyFilter(value: string) {
            cards.forEach((card) => {
                const matches = value === "all" || card.dataset.category === value;
                card.style.display = matches ? "" : "none";
            });
        }

        radios.forEach((radio) => {
            radio.addEventListener("change", () => {
                if (radio.checked) applyFilter(radio.value);
            });
        });

        const checked = document.querySelector<HTMLInputElement>('input[name="filter"]:checked');
        if (checked) applyFilter(checked.value);
    }

    document.addEventListener("astro:page-load", initFilter);
</script>
