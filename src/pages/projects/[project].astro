---
import Page from "../../layouts/page.astro";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import { detailTransition } from "../../transitions";
import PdfModal from "../../components/PdfModal.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((entry, i) => ({
        params: { project: entry.data.slug ?? entry.id },
        props: { entry, next: projects[(i + 1) % projects.length] },
    }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);

const {
    styledTitle,
    title,
    description,
    role,
    year,
    team,
    technologies,
    stack,
    problem,
    outcome,
    impact,
    mockupFile,
} = entry.data;
---

<style>
    @reference "#global.css";

    .meta-row {
        @apply flex justify-between items-baseline py-4 border-b-2 border-border gap-8;
    }

    .meta-row:first-child {
        @apply pt-0;
    }

    .meta-label {
        @apply text-sm font-display tracking-widest uppercase text-text-highlight shrink-0;
    }

    .meta-value {
        @apply text-base text-text text-right;
    }

    .summary-card {
        @apply flex flex-col gap-3 p-5 rounded-lg border border-border bg-bg;
    }

    .summary-card-label {
        @apply text-xs font-display tracking-widest uppercase text-text-highlight;
    }

    .prose :global(h2) {
        @apply text-3xl font-display font-bold text-text mb-4 leading-tight;
    }

    .prose :global(h3) {
        @apply text-xl font-medium text-text mt-8 mb-3;
    }

    .prose :global(p) {
        @apply text-text-muted leading-relaxed mb-4;
    }

    .prose :global(ul) {
        @apply list-disc pl-6 text-text-muted space-y-2 mb-4;
    }

    .prose :global(img) {
        @apply w-full rounded-lg border border-border my-8;
    }
</style>

<Page
    title={`${title} — Stiven Ilarraza`}
    description={description}
>
    <section
        class="flex flex-col h-full w-full overflow-y-auto"
        transition:name="page-content"
        transition:animate={detailTransition}>
        <div
            class="flex flex-col gap-10 lg:gap-16 px-4 sm:px-6 lg:px-[4vw] pt-20 lg:pt-12">
            <!-- HERO -->
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 items-start">
                <div class="flex flex-col gap-8 w-full lg:w-1/2">
                    <a
                        href="/projects"
                        class="flex items-center gap-2 text-xs font-display tracking-widest uppercase text-text-muted hover:text-text transition-colors w-fit">
                        ← All Projects
                    </a>

                    <h1
                        class="font-display text-6xl sm:text-7xl lg:text-8xl font-medium uppercase leading-[0.82] tracking-[-0.04em]"
                        set:html={styledTitle ?? title}
                    />

                    <p
                        class="text-base lg:text-lg text-text-muted leading-relaxed max-w-prose">
                        {description}
                    </p>

                    {
                        mockupFile && (
                            <button
                                data-mockup-trigger
                                class="btn btn-primary flex items-center gap-2 w-fit">
                                <Icon
                                    name="mdi:file-pdf-box"
                                    class="w-4 h-4"
                                />
                                View Mockup
                            </button>
                        )
                    }
                </div>

                <div class="w-full lg:w-1/2 lg:pt-10">
                    <div class="meta-row">
                        <span class="meta-label">Year</span>
                        <span class="meta-value">{year}</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Team</span>
                        <span class="meta-value">{team}</span>
                    </div>
                    <div class="meta-row border-b-0">
                        <span class="meta-label">Stack</span>
                        <div class="flex items-center gap-3 justify-end">
                            <span class="meta-value">{stack}</span>
                            <button
                                id="tech-stack-trigger"
                                aria-label="View full tech stack"
                                class="px-2 py-0.5 rounded border border-border text-xs font-display tracking-widest uppercase text-text-muted hover:text-text hover:border-text-muted transition-colors shrink-0">
                                Full Stack
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SUMMARY CARDS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {
                    problem && (
                        <div class="summary-card">
                            <span class="summary-card-label">Problem</span>
                            <p class="text-sm text-text-muted leading-relaxed">
                                {problem}
                            </p>
                        </div>
                    )
                }
                {
                    role && (
                        <div class="summary-card">
                            <span class="summary-card-label">Role</span>
                            <p class="text-sm text-text-muted leading-relaxed">
                                {role}
                            </p>
                        </div>
                    )
                }
                {
                    outcome && (
                        <div class="summary-card">
                            <span class="summary-card-label">Outcome</span>
                            <p class="text-sm text-text-muted leading-relaxed">
                                {outcome}
                            </p>
                        </div>
                    )
                }
                {
                    impact && (
                        <div class="summary-card">
                            <span class="summary-card-label">Impact</span>
                            <p class="text-sm text-text-muted leading-relaxed">
                                {impact}
                            </p>
                        </div>
                    )
                }
            </div>

            <!-- BODY -->
            <div class="prose max-w-none">
                <Content />
            </div>

            <!-- FOOTER -->
            <div
                class="flex flex-col sm:flex-row items-center md:items-start justify-between gap-4 border-t border-border py-10 mb-8">
                <p class="text-text-muted">
                    Want the long version, or something similar built?
                </p>
                <div class="flex items-center gap-6">
                    <a
                        href="/contact"
                        class="btn btn-primary">
                        Get in Touch
                    </a>
                </div>
            </div>
        </div>
    </section>
<!-- Tech Stack Modal -->
<style is:global>
    @keyframes tech-stack-in {
        from { opacity: 0; transform: translateY(8px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes tech-stack-out {
        from { opacity: 1; transform: translateY(0) scale(1); }
        to   { opacity: 0; transform: translateY(8px) scale(0.97); }
    }
    @keyframes tech-stack-backdrop-in  { from { opacity: 0; } to { opacity: 1; } }
    @keyframes tech-stack-backdrop-out { from { opacity: 1; } to { opacity: 0; } }

    #tech-stack-modal[open] {
        animation: tech-stack-in 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    }
    #tech-stack-modal.is-closing {
        animation: tech-stack-out 0.2s cubic-bezier(0.55, 0, 1, 0.45) both;
    }
    #tech-stack-modal[open]::backdrop {
        animation: tech-stack-backdrop-in 0.25s ease both;
    }
    #tech-stack-modal.is-closing::backdrop {
        animation: tech-stack-backdrop-out 0.2s ease both;
    }
</style>

<dialog
    id="tech-stack-modal"
    aria-labelledby="tech-stack-modal-title"
    class="m-auto w-[calc(100%-2rem)] sm:w-full max-w-sm rounded-xl border-2 border-border bg-surface p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:flex-col">
    <div class="flex items-center justify-between border-b-2 border-border px-6 py-4 shrink-0">
        <span id="tech-stack-modal-title" class="font-display text-sm tracking-widest uppercase text-text-highlight">
            Tech Stack
        </span>
        <button
            id="tech-stack-modal-close"
            aria-label="Close"
            class="flex items-center justify-center w-8 h-8 rounded-md text-text-muted hover:text-text border-2 border-transparent hover:border-border transition-colors">
            <Icon name="mdi:close" class="w-5 h-5" />
        </button>
    </div>
    <div class="flex flex-wrap gap-2 p-6">
        {technologies.map((tech) => (
            <span class="px-3 py-1.5 rounded-md border border-border text-sm text-text-muted bg-bg">
                {tech}
            </span>
        ))}
    </div>
</dialog>

<script>
    function initTechStackModal() {
        const modal = document.getElementById("tech-stack-modal") as HTMLDialogElement | null;
        const trigger = document.getElementById("tech-stack-trigger");
        const closeBtn = document.getElementById("tech-stack-modal-close");
        if (!modal) return;

        function open() { modal!.showModal(); }
        function close() {
            modal!.classList.add("is-closing");
            modal!.addEventListener("animationend", () => {
                modal!.classList.remove("is-closing");
                modal!.close();
            }, { once: true });
        }

        trigger?.addEventListener("click", open);
        closeBtn?.addEventListener("click", close);
        modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
        modal.addEventListener("cancel", (e) => { e.preventDefault(); close(); });
    }

    initTechStackModal();
    document.addEventListener("astro:page-load", initTechStackModal);
</script>

{
    mockupFile && (
        <PdfModal
            id="mockup-modal"
            title="Project Mockup"
            src={`/mockups/${mockupFile}`}
            downloadHref={`/mockups/${mockupFile}`}
            shareTitle={`${title} — Mockup`}
            triggerAttribute="mockup-trigger"
        />
    )
}

</Page>
