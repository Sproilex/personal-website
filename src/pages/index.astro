---
import Page from "../layouts/page.astro";
---

<Page>
    <section
        class="absolute inset-0 z-10 pl-[80px]"
        aria-labelledby="hero-title">
        <div class="flex h-full w-full items-center">
            <div class="flex flex-col gap-8 ml-[8vw] max-w-[400px]">
                <h1
                    id="hero-title"
                    class="font-display text-8xl font-medium uppercase leading-[0.82] tracking-[-0.065em]">
                    <span class="block text-text"> Stiven </span>
                    <span class="block text-text-highlight"> Ilarraza </span>
                </h1>

                <p class="text-sm">
                    Software engineer with over 8 years of experience building
                    products, systems, and digital experiences across the stack.
                </p>

                <div class="flex justify-between gap-4">
                    <button class="btn btn-primary"> Get in Touch </button>

                    <button class="btn"> See Projects </button>
                </div>
            </div>
        </div>
    </section>
</Page>
