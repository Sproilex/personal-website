---
import { getCollection } from "astro:content";
import Page from "../layouts/page.astro";
import { homeTransition } from "../transitions";

const featuredProjects = (await getCollection("projects"))
    .filter((e) => e.data.featuredProject === true)
    .map((e) => ({
        id: e.id,
        title: e.data.title,
        description: e.data.description,
        href: `/projects/${e.data.slug ?? e.id}`,
        thumbnail: e.data.image ? `/images/${e.data.image}` : undefined,
    }));
---

<Page>
    <script
        type="application/json"
        id="star-projects"
        set:html={JSON.stringify(featuredProjects)}
    />
    <section
        class="absolute inset-0 z-10 lg:pl-[80px]"
        aria-labelledby="hero-title"
        transition:name="page-content"
        transition:animate={homeTransition}>
        <div
            class="flex h-full w-full justify-center items-center lg:justify-start">
            <div
                class="flex flex-col gap-8 px-6 lg:px-0 lg:ml-[8vw] max-w-[500px] lg:max-w-[400px] w-full">
                <h1
                    id="hero-title"
                    class="font-display text-center text-7xl sm:text-6xl md:text-8xl lg:text-left lg:text-8xl font-medium uppercase leading-[0.82] tracking-[-0.04em]">
                    <span class="block text-text"> Stiven </span>
                    <span class="block text-text-highlight"> Ilarraza </span>
                </h1>

                <p class="text-center text-base lg:text-sm lg:text-left">
                    Software engineer with over 8 years of experience building
                    products, systems, and digital experiences across the stack.
                </p>

                <div class="flex justify-between gap-4">
                    <a href="/contact" class="btn btn-primary"> Get in Touch </a>

                    <a href="/projects" class="btn"> See Projects </a>
                </div>
            </div>
        </div>
    </section>
</Page>
