---
import Page from "../layouts/page.astro";
import { aboutTransition } from "../transitions";
---

<style>
    @reference "#global.css";

    .abilities li {
        @apply flex gap-4;
    }

    .abilities h2 {
        @apply text-2xl mb-2 leading-[1];
    }

    .abilities p {
        @apply text-base text-text-muted;
    }

    .abilities span {
        @apply text-sm text-text-highlight;
    }
</style>

<Page
    title="About — Stiven Ilarraza"
    description="Software engineer with 8+ years shipping full-stack products. I build from schema and API to the pixels people actually touch."
>
    <div
        class="flex flex-col lg:flex-row w-full lg:ml-[4vw] gap-4 lg:pr-[120px] overflow-y-auto lg:overflow-visible pt-20 lg:pt-0 pb-8 lg:pb-0 px-6 lg:px-0 lg:h-full"
        transition:name="page-content"
        transition:animate={aboutTransition}>
        <section
            class="w-full lg:w-[60%]"
            aria-labelledby="about-stiven">
            <div class="flex w-full items-center lg:h-full">
                <div class="flex flex-col gap-8">
                    <h1
                        id="about-stiven"
                        class="font-display text-base text-text-highlight uppercase leading-[0.82]">
                        About
                    </h1>

                    <p
                        class="font-display text-3xl lg:text-5xl weight-medium leading-[1.2] tracking-[-0.04em] text-text">
                        I build software that has to <span
                            class="text-text-highlight">
                            survive contact with real users
                        </span>. Eight years of shipping products end to end,
                        from schema and API to the pixels people actually touch.
                    </p>

                    <div class="flex gap-8">
                        <a href="/contact" class="btn btn-primary"> Get in Touch </a>

                        <a href="/projects" class="btn"> See Projects </a>
                    </div>
                </div>
            </div>
        </section>
        <section
            aria-labelledby="abilities-heading"
            class="abilities flex justify-center items-center w-full lg:w-[40%] pt-4 lg:pt-0">
            <h2 id="abilities-heading" class="sr-only">Skills & expertise</h2>
            <ul class="flex flex-col gap-10 lg:gap-12 w-full">
                <li>
                    <span aria-hidden="true">01</span>
                    <div>
                        <h2>Product engineering</h2>
                        <p>
                            Building products end to end, from architecture and APIs to interfaces, integrations and production.
                        </p>
                    </div>
                </li>
                <li>
                    <span aria-hidden="true">02</span>
                    <div>
                        <h2>Backend & architecture</h2>
                        <p>
                            Node.js and TypeScript services, APIs, domain-driven design and distributed systems built to scale.
                        </p>
                    </div>
                </li>
                <li>
                    <span aria-hidden="true">03</span>
                    <div>
                        <h2>Integrations & automation</h2>
                        <p>
                            Connecting products with external APIs, webhooks, data synchronization and automated business workflows.
                        </p>
                    </div>
                </li>
                <li>
                    <span aria-hidden="true">04</span>
                    <div>
                        <h2>AI-powered systems</h2>
                        <p>
                            AI agents, data extraction and automated workflows integrated into real production products.
                        </p>
                    </div>
                </li>
                <li>
                    <span aria-hidden="true">05</span>
                    <div>
                        <h2>Technical leadership</h2>
                        <p>
                            Architecture decisions, code reviews, technical direction and helping teams build better software.
                        </p>
                    </div>
                </li>
            </ul>
        </section>
    </div>
</Page>
