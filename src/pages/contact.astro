---
import Page from "../layouts/page.astro";
import { Icon } from "astro-icon/components";
import PillSelect from "../components/PillSelect.astro";
import { contactTransition } from "../transitions";
---

<style>
    @reference "#global.css";

    .form-step {
        @apply flex gap-4 w-full justify-start items-start;
    }

    .form-step div {
        @apply flex flex-col justify-center w-full;
    }

    .form-step span {
        @apply text-sm text-text-highlight;
    }

    form label {
        @apply text-xl mb-2 leading-[1.1];
    }

    form input:not([type="radio"]) {
        @apply w-full bg-bg border-2 border-border rounded-md p-2 text-text;
    }
</style>

<Page
    title="Contact — Stiven Ilarraza"
    description="Got a product to build, an issue to sort out, or a role to fill? Get in touch — I read everything and reply within a day."
>
    <div
        class="flex flex-col lg:flex-row w-full lg:ml-[4vw] lg:mr-[4vw] gap-8 md:gap-16 overflow-y-auto lg:overflow-visible pt-20 lg:pt-0 pb-8 lg:pb-0 px-6 lg:px-0 lg:h-full"
        transition:name="page-content"
        transition:animate={contactTransition}>
        <section
            class="w-full lg:w-[60%]"
            aria-labelledby="contact-heading">
            <div class="flex w-full items-center lg:h-full">
                <div class="flex flex-col gap-8">
                    <h1
                        id="contact-heading"
                        class="font-display text-base text-text-highlight uppercase leading-[0.82]">
                        Contact
                    </h1>
                    <p
                        class="font-display text-3xl lg:text-5xl weight-medium leading-[1.2] tracking-[-0.04em] text-text">
                        Got a product to create, an issue to sort out, or a role
                        to fill? <span class="text-text-highlight"
                            >Start the conversation here</span
                        >. I read everything and reply within a day.
                    </p>

                    <ul class="flex gap-12">
                        <li>
                            <a
                                href="https://www.linkedin.com/in/stivenilarraza/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex justify-center items-center gap-2 text-text-muted hover:text-text transition-colors"
                                ><Icon
                                    class="w-5 h-5 transition-all shrink-0"
                                    name="mdi:linkedin"
                                /> Linkedin</a
                            >
                        </li>
                        <li>
                            <button
                                data-resume-trigger
                                class="flex justify-center items-center gap-2 text-text-muted hover:text-text transition-colors"
                                ><Icon
                                    class="w-5 h-5 transition-all shrink-0"
                                    name="mdi:file"
                                /> Resume</button
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </section>
        <section
            aria-labelledby="abilities"
            class="abilities flex justify-center items-center w-full lg:w-[40%]">
            <form class="flex flex-col gap-8 w-full">
                <div class="form-step">
                    <span>01</span>
                    <div>
                        <label>Your Name</label>
                        <input
                            type="text"
                            placeholder="Jane Doe"
                        />
                    </div>
                </div>
                <div class="form-step">
                    <span>02</span>
                    <div>
                        <label>Email</label>
                        <input
                            type="email"
                            placeholder="jane.doe@example.com"
                        />
                    </div>
                </div>
                <div class="form-step">
                    <span>03</span>
                    <div>
                        <label>What do you need?</label>
                        <PillSelect
                            name="needs"
                            options={[
                                {
                                    label: "Product build",
                                    value: "product-build",
                                },
                                { label: "Consulting", value: "consulting" },
                                {
                                    label: "Full-time role",
                                    value: "full-time-role",
                                },
                                {
                                    label: "Part-time role",
                                    value: "part-time-role",
                                },
                                {
                                    label: "Other",
                                    value: "other",
                                },
                            ]}
                        />
                    </div>
                </div>
                <div class="form-step">
                    <span>04</span>
                    <div>
                        <label>Message</label>
                        <textarea
                            placeholder="Write your message here..."
                            class="w-full bg-bg border-2 border-border rounded-md p-2 text-text h-[150px]"
                        ></textarea>
                    </div>
                </div>
                <div
                    class="flex flex-col sm:flex-row items-center justify-between gap-4 pl-8">
                    <button
                        type="submit"
                        class="btn btn-primary">
                        Send Message
                    </button>

                    <span class="align-middle text-sm text-text-muted">
                        Usually answered within 24 hours
                    </span>
                </div>
            </form>
        </section>
    </div>
</Page>
